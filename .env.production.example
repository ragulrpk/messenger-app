POSTGRES_DB=messenger
POSTGRES_USER=messenger_app
POSTGRES_PASSWORD=replace-with-a-long-random-secret
# Use a distinct DDL-capable role in managed production databases.
MIGRATION_DB_URL=jdbc:postgresql://postgres:5432/messenger
MIGRATION_DB_USERNAME=messenger_migrator
MIGRATION_DB_PASSWORD=replace-with-a-separate-migration-secret
REDIS_PASSWORD=replace-with-a-different-long-random-secret
PUBLIC_ORIGIN=https://messenger.example.com
PUBLIC_PORT=8080
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW=60s
MAX_SESSIONS_PER_USER=5
MAX_REQUEST_HEADER_SIZE=16KB
MAX_REQUEST_BODY_SIZE=64KB
TOMCAT_MAX_THREADS=200
TOMCAT_MIN_SPARE_THREADS=10
TOMCAT_MAX_CONNECTIONS=8192
TOMCAT_ACCEPT_COUNT=100
DB_POOL_SIZE=10
DB_MIN_IDLE=2
DB_QUERY_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
DB_KEEPALIVE_TIME_MS=120000
