POSTGRES_DB=messenger
POSTGRES_USER=messenger_app
POSTGRES_PASSWORD=replace-with-a-long-random-secret
# Optional: provision a separate migration role first, then override MIGRATION_DB_*.
# The bundled database defaults to POSTGRES_USER for migrations.
REDIS_PASSWORD=replace-with-a-different-long-random-secret
PUBLIC_ORIGIN=https://lets-talk.example.com
PUBLIC_PORT=8080
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW=60s
MAX_SESSIONS_PER_USER=1
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=replace-with-a-long-random-admin-secret
BOOTSTRAP_EMAIL=admin@example.com
MAX_REQUEST_HEADER_SIZE=16KB
MAX_REQUEST_BODY_SIZE=64KB
TOMCAT_MAX_THREADS=200
TOMCAT_MIN_SPARE_THREADS=10
TOMCAT_MAX_CONNECTIONS=8192
TOMCAT_ACCEPT_COUNT=100
DB_POOL_SIZE=10
DB_MIN_IDLE=2
DB_QUERY_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
DB_KEEPALIVE_TIME_MS=120000

# Optional browser push. Generate once: java backend/demo/scripts/GeneratePushKeys.java
# Use the same key pair on every backend replica. Keep the private key secret.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=
