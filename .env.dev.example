# Copy this file to .env in the repository root (already ignored by Git).
# Replace both placeholders before starting the development environment.
# These values are for the fresh Docker database, not Windows PostgreSQL.
POSTGRES_USER=replace_with_dev_username
POSTGRES_PASSWORD=replace_with_dev_password
# Credentials initialize a fresh volume only; changing them does not update
# users/passwords in an already initialized PostgreSQL volume.
