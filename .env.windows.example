# Copy to .env.windows. This file configures Dockerized frontend/backend to
# connect to PostgreSQL running directly on Windows.
POSTGRES_DB=messenger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-the-windows-postgres-password
PUBLIC_PORT=8080

# Optional local-only account provisioning. The account is created only when
# absent; an existing account/password is never changed.
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=
