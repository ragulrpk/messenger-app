# Copy to .env and replace these placeholders locally. Never commit .env.
DB_USERNAME=replace_with_database_username
DB_PASSWORD=replace_with_database_password

# Optional pass-through values. Default-profile startup does not create users.
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=

# Optional browser push. Generate once: java backend/demo/scripts/GeneratePushKeys.java
# Use the same key pair on every backend replica. Keep the private key secret.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=
