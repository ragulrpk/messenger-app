# Copy to k8s/.env and edit locally. Never commit the real .env.
# For Docker Desktop with PostgreSQL on Windows, try host.docker.internal.
# For other clusters, replace with a database hostname reachable by the pods.
DB_URL=jdbc:postgresql://host.docker.internal:5432/messenger
DB_USERNAME=REPLACE_WITH_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
REDIS_URL=redis://messenger-redis:6379

# Optional browser push. Generate once: java backend/demo/scripts/GeneratePushKeys.java
# Use the same key pair on every backend replica. Keep the private key secret.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=

# First administrator on a fresh database. Remove the password after provisioning.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=REPLACE_WITH_LONG_RANDOM_ADMIN_PASSWORD
BOOTSTRAP_EMAIL=admin@example.com

# Backend must trust only the frontend proxy peers; replace with your pod-network range.
# Example for a 10.244.x.x pod network (not a universal cluster default).
TRUSTED_PROXY_PATTERN=10[.]244[.]\d+[.]\d+
FILE_MAX_SIZE=5MB
FILE_VIDEO_MAX_SIZE=200MB
FILE_MAX_REQUEST_SIZE=201MB
FILE_DAILY_QUOTA=1GB
FILE_RETENTION=60d
