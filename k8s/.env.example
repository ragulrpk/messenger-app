# Copy to k8s/.env and edit locally. Never commit the real .env.
# For Docker Desktop with PostgreSQL on Windows, try host.docker.internal.
# For other clusters, replace with a database hostname reachable by the pods.
DB_URL=jdbc:postgresql://host.docker.internal:5432/messenger
DB_USERNAME=REPLACE_WITH_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
REDIS_URL=redis://messenger-redis:6379
